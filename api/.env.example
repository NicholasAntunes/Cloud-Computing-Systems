# API settings (docs/PLAN.md §9). Copy to api/.env (gitignored) and replace every change-me.
# These values run the API outside Docker Compose, with Azurite and PostgreSQL on 127.0.0.1.
# Inside Compose, use the service names instead: azurite and db.

# --- Blob Storage ---
STORAGE_AUTH=connection_string
# Azurite's well-known development account and key, published by Microsoft. Not a secret.
BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# Azure only, with STORAGE_AUTH=managed_identity:
# BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
BLOB_CONTAINER=files

# --- Database ---
# Matches the local postgres:16 container (user, password and database "cloudfiles").
DATABASE_URL=postgresql+psycopg://cloudfiles:cloudfiles@127.0.0.1:5432/cloudfiles

# --- Tokens (Phase 2) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Uploads ---
MAX_UPLOAD_MB=100

# --- CORS (unused while web and API share one origin; Phase 6) ---
CORS_ORIGINS=https://localhost

# --- First admin, created at startup when there are no users ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
