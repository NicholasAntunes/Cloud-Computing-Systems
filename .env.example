# ==============================================================================
# Cloud File Exchange System - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# For details, refer to PLAN.md §9 (Configuration & Known Pitfalls)
# ==============================================================================

# ------------------------------------------------------------------------------
# Storage Configuration (Azure Blob Storage / Azurite)
# ------------------------------------------------------------------------------
# In local development: STORAGE_AUTH=connection_string
# On Microsoft Azure:   STORAGE_AUTH=managed_identity
STORAGE_AUTH=connection_string

# Default Azurite development connection string.
# NOTE for Docker Compose: inside the compose network, use host "azurite" (default below).
# If running API directly on the host machine outside Docker, replace "azurite" with "127.0.0.1".
BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;

# Azure Blob Account URL (used only when STORAGE_AUTH=managed_identity on Azure)
# BLOB_ACCOUNT_URL=https://<storage-account-name>.blob.core.windows.net

# Name of the private blob container for uploaded files
BLOB_CONTAINER=files

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=cloudfiles
POSTGRES_PASSWORD=cloudfiles_dev_password
POSTGRES_DB=cloudfiles
POSTGRES_PORT=5432

# SQLAlchemy Database URL:
# Inside Docker Compose network (host: "db"):
DATABASE_URL=postgresql+psycopg://cloudfiles:cloudfiles_dev_password@db:5432/cloudfiles
# If running API directly on host outside Docker (host: "localhost"):
# DATABASE_URL=postgresql+psycopg://cloudfiles:cloudfiles_dev_password@localhost:5432/cloudfiles

# ------------------------------------------------------------------------------
# Security & Authentication (JWT & Argon2id)
# ------------------------------------------------------------------------------
# In production on Azure, load this secret from Azure Key Vault (min 32 characters)
JWT_SECRET=dev_jwt_secret_key_change_in_production_super_secret_minimum_32_chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Initial seed admin user (Phase 2)
ADMIN_EMAIL=admin@cloudfiles.local
ADMIN_PASSWORD=admin_dev_password

# ------------------------------------------------------------------------------
# Application Limits & Network / CORS
# ------------------------------------------------------------------------------
# Maximum file upload size in MB (enforced on streaming)
MAX_UPLOAD_MB=100

# Allowed CORS origins (comma-separated). Caddy terminates TLS locally at https://localhost
CORS_ORIGINS=https://localhost,http://localhost:5173
